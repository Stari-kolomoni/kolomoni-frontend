{
	"name": "kolomoni-frontend",
	"version": "0.0.1",
	"private": true,
	"license": "GPL-3.0-only",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"api:clean": "tsx ./scripts/clean-api-schema-types-and-validators.ts",
		"api:generate": "yarn api-schema:generate && yarn api-validators:generate",
		"api-schema:generate": "tsx ./scripts/generate-api-schema-types.ts",
		"api-validators:generate": "tsx ./scripts/generate-api-schema-validators.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^3.3.1",
		"@sveltejs/kit": "^2.15.1",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@types/eslint": "9.6.1",
		"@types/node": "^20.11.16",
		"@typescript-eslint/eslint-plugin": "^8.19.1",
		"@typescript-eslint/parser": "^8.19.1",
		"ajv": "^8.12.0",
		"eslint": "^9.17.0",
		"eslint-plugin-svelte": "^2.46.1",
		"openapi-typescript": "^7.5.1",
		"sass": "^1.83.1",
		"stylelint": "^16.12.0",
		"stylelint-config-standard-scss": "^14.0.0",
		"svelte": "^5.16.3",
		"svelte-check": "^4.1.1",
		"svelte-preprocess": "^6.0.3",
		"sveltekit-adapter-deno": "^0.16.1",
		"tslib": "^2.8.1",
		"tsx": "^4.19.2",
		"typescript": "^5.7.2",
		"typescript-json-schema": "^0.65.1",
		"vite": "^6.0.7"
	},
	"type": "module",
	"packageManager": "yarn@4.1.0",
	"dependencies": {
		"bits-ui": "1.0.0-next.77"
	}
}
