{
	"name": "kolomoni-frontend",
	"version": "0.0.1",
	"private": true,
	"license": "GPL-3.0-only",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"api:clean": "tsx ./scripts/clean-api-schema-types-and-validators.ts",
		"api:generate": "yarn api-schema:generate && yarn api-validators:generate",
		"api-schema:generate": "tsx ./scripts/generate-api-schema-types.ts",
		"api-validators:generate": "tsx ./scripts/generate-api-schema-validators.ts"
	},
	"devDependencies": {
		"@eslint/js": "^9.34.0",
		"@sveltejs/adapter-auto": "^6.1.0",
		"@sveltejs/kit": "^2.36.3",
		"@sveltejs/vite-plugin-svelte": "^6.1.3",
		"@types/eslint": "9.6.1",
		"@types/node": "^20.19.11",
		"ajv": "^8.17.1",
		"eslint": "^9.34.0",
		"eslint-plugin-svelte": "^3.11.0",
		"openapi-typescript": "^7.9.1",
		"sass": "^1.91.0",
		"stylelint": "^16.23.1",
		"stylelint-config-standard-scss": "^15.0.1",
		"svelte": "^5.38.6",
		"svelte-check": "^4.3.1",
		"svelte-preprocess": "^6.0.3",
		"sveltekit-adapter-deno": "^0.16.1",
		"tslib": "^2.8.1",
		"tsx": "^4.20.5",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.41.0",
		"typescript-json-schema": "^0.65.1",
		"vite": "^7.1.3"
	},
	"type": "module",
	"packageManager": "yarn@4.9.1",
	"dependencies": {
		"@indaco/svelte-iconoir": "^7.11.1",
		"bits-ui": "2.14.1"
	}
}
