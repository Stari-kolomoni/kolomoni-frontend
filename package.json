{
	"name": "kolomoni-frontend",
	"version": "0.0.1",
	"private": true,
	"license": "GPL-3.0-only",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"api:clean": "tsx ./scripts/clean-api-schema-types-and-validators.ts",
		"api:generate": "yarn api-schema:generate && yarn api-validators:generate",
		"api-schema:generate": "tsx ./scripts/generate-api-schema-types.ts",
		"api-validators:generate": "tsx ./scripts/generate-api-schema-validators.ts"
	},
	"devDependencies": {
		"@eslint/js": "^9.25.1",
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/kit": "^2.20.7",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@types/eslint": "9.6.1",
		"@types/node": "^20.11.16",
		"ajv": "^8.17.1",
		"eslint": "^9.25.1",
		"eslint-plugin-svelte": "^3.5.1",
		"openapi-typescript": "^7.6.1",
		"sass": "^1.87.0",
		"stylelint": "^16.18.0",
		"stylelint-config-standard-scss": "^14.0.0",
		"svelte": "^5.28.2",
		"svelte-check": "^4.1.6",
		"svelte-preprocess": "^6.0.3",
		"sveltekit-adapter-deno": "^0.16.1",
		"tslib": "^2.8.1",
		"tsx": "^4.19.3",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.31.0",
		"typescript-json-schema": "^0.65.1",
		"vite": "^6.0.7"
	},
	"type": "module",
	"packageManager": "yarn@4.9.1",
	"dependencies": {
		"bits-ui": "1.3.19"
	}
}
